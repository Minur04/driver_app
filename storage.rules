rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Driver Verification Documents: driverDocuments/{driverUid}/{documentKey}.jpg
    match /driverDocuments/{driverUid}/{documentFile} {
      // Drivers can only upload to their own folder
      // Only image files allowed, maximum 10MB
      allow write: if request.auth != null 
                   && request.auth.uid == driverUid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Only the driver themselves or an authorized administrator can view documents
      // Strictly NO public access
      allow read: if request.auth != null 
                  && (request.auth.uid == driverUid || request.auth.token.admin == true);
      
      // Drivers cannot delete verification documents once submitted; only admin can
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Default rule: disallow everything else unless explicitly specified
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
